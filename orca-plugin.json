{
  "manifestVersion": 1,
  "id": "project-groups-sync",
  "publisher": "b0c1",
  "name": "Project Groups Sync",
  "version": "1.0.1",
  "repository": "https://github.com/b0c1/orca-project-groups-sync",
  "description": "Keeps project groups in a JSON file you can edit by hand or share between devices through a synced folder.",
  "engines": { "orca": ">=1.4.215" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "commands": [{ "id": "project-groups-sync-now", "title": "Project Groups: Sync Now" }],
    "events": [{ "on": "projects.changed" }]
  },
  "capabilities": [
    { "kind": "projects:organize" },
    { "kind": "storage" },
    { "kind": "events:subscribe" },
    { "kind": "notifications:show" }
  ]
}
